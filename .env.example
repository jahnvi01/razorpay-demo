# Public URL used in links sent to customers (statement page, pay link callback).
APP_URL=https://udhaar-suite.vercel.app

# Copy to .env.local and fill in. On Vercel, set these in Project Settings > Environment Variables.

# Supabase (Mumbai region). Secret key is server only.
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Razorpay test mode (UD-04). Server only.
RAZORPAY_API_KEY=rzp_test_...
RAZORPAY_API_SECRET=
# Any long random string. Paste the same value in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Vercel Cron sends this as a Bearer token to /api/cron/* (UD-20). Any long random string.
CRON_SECRET=

# Postgres connection string, used only by `npm run db:migrate`. Keep it local; not needed on Vercel.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Web Push (UD-61). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
